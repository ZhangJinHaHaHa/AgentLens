{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentlens.example/agentlens-wire.v1.schema.json",
  "title": "AgentLens Wire v1",
  "description": "Bidirectional, keyless-in-frame execution protocol between the AgentLens Supervisor and managed or seller-hosted Agent runtimes.",
  "oneOf": [
    { "$ref": "#/$defs/sessionStart" },
    { "$ref": "#/$defs/runtimeEvent" },
    { "$ref": "#/$defs/capabilityCall" },
    { "$ref": "#/$defs/capabilityResult" },
    { "$ref": "#/$defs/checkpointFrame" },
    { "$ref": "#/$defs/approvalUpdate" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/heartbeatAck" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/resume" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "capability": {
      "enum": [
        "platform_model.invoke",
        "search.plan",
        "search.execute",
        "web.read",
        "brokered_http.request",
        "browser.session.open",
        "browser.navigate",
        "browser.observe",
        "browser.action",
        "browser.session.close",
        "project_file.list",
        "project_file.read",
        "project_file.search",
        "project_file.write",
        "project_file.patch",
        "project_change_set.preview",
        "project_test.run",
        "project_toolchain.run",
        "project_change_set.commit",
        "artifact.create",
        "calculator.run",
        "code.run",
        "approval.request"
      ]
    },
    "base": {
      "type": "object",
      "required": ["wireVersion", "kind", "sessionId", "runId", "taskId", "sequence", "sentAt"],
      "properties": {
        "wireVersion": { "const": "agentlens.wire.v1" },
        "kind": {
          "enum": [
            "session_start",
            "runtime_event",
            "capability_call",
            "capability_result",
            "checkpoint",
            "approval_update",
            "heartbeat",
            "heartbeat_ack",
            "cancel",
            "resume",
            "result"
          ]
        },
        "sessionId": { "$ref": "#/$defs/identifier" },
        "runId": { "$ref": "#/$defs/identifier" },
        "taskId": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "sentAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "resourceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedModelIds",
        "readableProjectFileIds",
        "writableProjectPathPrefixes",
        "allowedApprovalActions"
      ],
      "dependentRequired": {
        "browserMode": ["browserAllowedHosts"],
        "browserAllowedHosts": ["browserMode"]
      },
      "properties": {
        "allowedModelIds": { "$ref": "#/$defs/stringArray" },
        "readableProjectFileIds": { "$ref": "#/$defs/stringArray" },
        "writableProjectPathPrefixes": { "$ref": "#/$defs/stringArray" },
        "allowedApprovalActions": { "$ref": "#/$defs/stringArray" },
        "browserMode": { "enum": ["read_only", "interactive"] },
        "browserAllowedHosts": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "capabilityCalls",
        "modelCredits",
        "searchCredits",
        "computeCredits",
        "storageCredits",
        "sellerAgentCredits",
        "totalCredits"
      ],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "capabilityCalls": { "type": "integer", "minimum": 0 },
        "modelCredits": { "type": "number", "minimum": 0 },
        "searchCredits": { "type": "number", "minimum": 0 },
        "computeCredits": { "type": "number", "minimum": 0 },
        "storageCredits": { "type": "number", "minimum": 0 },
        "sellerAgentCredits": { "type": "number", "minimum": 0 },
        "totalCredits": { "type": "number", "minimum": 0 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retryable": { "type": "boolean" }
      }
    },
    "artifactLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "locator"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": [
            "artifact",
            "page",
            "slide",
            "section",
            "line_range",
            "sheet_cell",
            "json_pointer"
          ]
        },
        "locator": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "claim", "disposition", "artifactIds"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/identifier" },
        "claim": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "sourceId": { "$ref": "#/$defs/identifier" },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "pattern": "^https?://"
        },
        "sourceTitle": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "evidenceSha256": { "$ref": "#/$defs/hash" },
        "disposition": { "enum": ["used", "background", "rejected"] },
        "artifactIds": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "artifactLocations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/artifactLocation" }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointId", "stateRef", "stateSha256", "resumable", "reason", "createdAt"],
      "properties": {
        "checkpointId": { "$ref": "#/$defs/identifier" },
        "previousCheckpointId": { "$ref": "#/$defs/identifier" },
        "stateRef": { "$ref": "#/$defs/identifier" },
        "stateSha256": { "$ref": "#/$defs/hash" },
        "resumable": { "type": "boolean" },
        "reason": { "enum": ["periodic", "approval", "compaction", "user_stop", "step_complete"] },
        "createdAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "sessionStart": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["agentId", "executionMode", "task", "grant"],
          "properties": {
            "kind": { "const": "session_start" },
            "agentId": { "$ref": "#/$defs/identifier" },
            "executionMode": { "enum": ["platform_managed", "seller_hosted_api"] },
            "task": {
              "type": "object",
              "additionalProperties": false,
              "required": ["goal", "constraints", "contextSnapshotRef", "contextSnapshotSha256", "budget"],
              "properties": {
                "goal": { "type": "string", "minLength": 1, "maxLength": 20000 },
                "constraints": { "$ref": "#/$defs/stringArray" },
                "contextSnapshotRef": { "$ref": "#/$defs/identifier" },
                "contextSnapshotSha256": { "$ref": "#/$defs/hash" },
                "budget": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["maxCredits", "maxDurationSeconds"],
                  "properties": {
                    "maxCredits": { "type": "number", "minimum": 0, "maximum": 1000000 },
                    "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
                  }
                }
              }
            },
            "grant": {
              "type": "object",
              "additionalProperties": false,
              "required": ["grantId", "expiresAt", "capabilities", "resourceScope"],
              "properties": {
                "grantId": { "$ref": "#/$defs/identifier" },
                "expiresAt": { "$ref": "#/$defs/timestamp" },
                "capabilities": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/capability" }
                },
                "resourceScope": { "$ref": "#/$defs/resourceScope" }
              }
            },
            "resume": { "$ref": "#/$defs/checkpoint" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runtimeEvent": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event"],
          "properties": {
            "kind": { "const": "runtime_event" },
            "event": {
              "type": "object",
              "additionalProperties": false,
              "required": ["eventId", "eventType", "occurredAt"],
              "properties": {
                "eventId": { "$ref": "#/$defs/identifier" },
                "eventType": {
                  "enum": [
                    "turn.started",
                    "turn.completed",
                    "step.started",
                    "step.completed",
                    "content.delta",
                    "tool.requested",
                    "tool.completed",
                    "approval.waiting",
                    "approval.decided",
                    "subagent.started",
                    "subagent.completed",
                    "compaction.started",
                    "compaction.completed",
                    "artifact.created",
                    "status.changed",
                    "usage.updated",
                    "warning",
                    "failure"
                  ]
                },
                "occurredAt": { "$ref": "#/$defs/timestamp" },
                "message": { "type": "string", "minLength": 1, "maxLength": 20000 },
                "span": { "type": "object" },
                "content": { "type": "object" },
                "tool": { "type": "object" },
                "approval": { "type": "object" },
                "subagent": { "type": "object" },
                "compaction": { "type": "object" },
                "artifact": { "type": "object" },
                "status": { "type": "object" },
                "usage": { "$ref": "#/$defs/usage" },
                "failure": { "$ref": "#/$defs/failure" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "capabilityCall": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["requestId", "capability", "idempotencyKey", "input", "costCeilingCredits", "timeoutMs"],
          "properties": {
            "kind": { "const": "capability_call" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "capability": { "$ref": "#/$defs/capability" },
            "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 },
            "input": {},
            "costCeilingCredits": { "type": "number", "minimum": 0, "maximum": 1000000 },
            "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "capabilityResult": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["requestId", "capability", "status", "usage"],
          "properties": {
            "kind": { "const": "capability_result" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "capability": { "$ref": "#/$defs/capability" },
            "status": { "enum": ["completed", "failed", "replayed"] },
            "callId": { "$ref": "#/$defs/identifier" },
            "output": {},
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["inputBytes", "outputBytes", "costCredits", "sourceCount"],
              "properties": {
                "inputBytes": { "type": "integer", "minimum": 0 },
                "outputBytes": { "type": "integer", "minimum": 0 },
                "costCredits": { "type": "number", "minimum": 0 },
                "sourceCount": { "type": "integer", "minimum": 0 }
              }
            },
            "failure": { "$ref": "#/$defs/failure" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "checkpointFrame": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["checkpoint"],
          "properties": {
            "kind": { "const": "checkpoint" },
            "checkpoint": { "$ref": "#/$defs/checkpoint" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "approvalUpdate": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["requestId", "approvalId", "action", "actionInputHash", "status"],
          "properties": {
            "kind": { "const": "approval_update" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "approvalId": { "$ref": "#/$defs/identifier" },
            "action": { "type": "string", "minLength": 1, "maxLength": 160 },
            "actionInputHash": { "$ref": "#/$defs/hash" },
            "status": { "enum": ["pending", "approved", "rejected", "expired"] },
            "decidedAt": { "$ref": "#/$defs/timestamp" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "heartbeat": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["nonce", "observedAt"],
          "properties": {
            "kind": { "const": "heartbeat" },
            "nonce": { "$ref": "#/$defs/identifier" },
            "observedAt": { "$ref": "#/$defs/timestamp" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "heartbeatAck": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["nonce", "observedAt"],
          "properties": {
            "kind": { "const": "heartbeat_ack" },
            "nonce": { "$ref": "#/$defs/identifier" },
            "observedAt": { "$ref": "#/$defs/timestamp" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "cancel": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["reasonCode", "message", "requestedAt"],
          "properties": {
            "kind": { "const": "cancel" },
            "reasonCode": { "$ref": "#/$defs/code" },
            "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "requestedAt": { "$ref": "#/$defs/timestamp" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "resume": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["checkpoint"],
          "properties": {
            "kind": { "const": "resume" },
            "checkpoint": { "$ref": "#/$defs/checkpoint" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "result": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": [
            "status",
            "completionStatus",
            "qualityStatus",
            "summary",
            "artifactIds",
            "usage",
            "completedAt"
          ],
          "properties": {
            "kind": { "const": "result" },
            "status": { "enum": ["completed", "failed", "cancelled"] },
            "completionStatus": { "enum": ["complete", "partial", "complete_with_warnings"] },
            "qualityStatus": { "enum": ["not_checked", "passed", "warning", "failed"] },
            "summary": { "type": "string", "minLength": 1, "maxLength": 200000 },
            "artifactIds": {
              "type": "array",
              "maxItems": 1000,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "evidence": {
              "type": "array",
              "maxItems": 1000,
              "items": { "$ref": "#/$defs/evidence" }
            },
            "usage": { "$ref": "#/$defs/usage" },
            "completedAt": { "$ref": "#/$defs/timestamp" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stringArray": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}
